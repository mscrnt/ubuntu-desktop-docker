# Copy to .env and fill in values.
USERNAME=user
PASSWORD=change-me
VNCPASSWORD=change-me

# Optional overrides
VNC_GEOMETRY=1920x1080
VNC_DEPTH=24

# Host port mappings (avoid 22 on hosts running sshd)
SSH_PORT=2222
RDP_PORT=3389
VNC_PORT=5901

# Service toggles (set to 1 to disable)
DISABLE_VNC=0
DISABLE_XRDP=0
DISABLE_SSH=0
