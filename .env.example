# Copy to .env and fill in values.
USERNAME=user
PASSWORD=change-me
VNCPASSWORD=change-me

# Optional overrides
VNC_GEOMETRY=1920x1080
VNC_DEPTH=24

# Host port mappings.
# - 22  is usually taken by the host's sshd, hence 2222.
# - 3389 is reserved by Windows Remote Desktop service; on Windows hosts use
#   13389 instead. Linux hosts can use 3389.
SSH_PORT=2222
RDP_PORT=13389
VNC_PORT=5901
NX_PORT=4000

# Service toggles (set to 1 to disable)
DISABLE_VNC=0
DISABLE_XRDP=0
DISABLE_SSH=0
# Only meaningful if the image was built with INCLUDE_NOMACHINE=true.
DISABLE_NOMACHINE=0
